# Copy to .env.local (gitignored) and fill in.

# Where the Stage 9 Insight API runs (api/, `npm start` there). Read server-side only.
# If it is unreachable, the dashboard falls back to bundled data and says so on every page.
OAH_API_URL=http://localhost:4000
# Set to 1 to log which data reader fell back on each request (the outage itself is always logged once).
# OAH_API_DEBUG=1

# Auth.js session signing key. Generate one with: npx auth secret
AUTH_SECRET=

# Optional "Continue with Google" -- see README-auth.md. Leave blank to use email/password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
