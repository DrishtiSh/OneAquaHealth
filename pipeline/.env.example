# Stage 1 (ingestion) simulator settings -- both optional, sane defaults apply.
OAH_RANDOM_SEED=42
OAH_N_WEEKS=104

# Week-grid anchor. Unset = the committed default (config.DEFAULT_ANCHOR_DATE, 2026-09-14),
# which regenerates exactly the committed data. "today" = live mode (today minus 14 days),
# which shifts every run and invalidates the committed Stage 5-6 outputs until re-run.
# OAH_ANCHOR_DATE=today

# Override the data directory (e.g. for held-out benchmark seeds).
# OAH_DATA_DIR=

# Optional real OAH API adapter (see pipeline/ingestion/real_source.py).
# Leave unset to run with simulator-only data (the default).
# OAH_API_BASE_URL=
# OAH_API_TOKEN=

# Set to "real" to make ingestion fail loudly if OAH_API_BASE_URL isn't set,
# instead of silently falling back to the simulator.
# INGESTION_MODE=real
