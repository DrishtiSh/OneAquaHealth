# Stage 1 (ingestion) simulator settings -- both optional, sane defaults apply.
OAH_RANDOM_SEED=42
OAH_N_WEEKS=104

# Optional real OAH API adapter (see pipeline/ingestion/real_source.py).
# Leave unset to run with simulator-only data (the default).
# OAH_API_BASE_URL=
# OAH_API_TOKEN=

# Set to "real" to make ingestion fail loudly if OAH_API_BASE_URL isn't set,
# instead of silently falling back to the simulator.
# INGESTION_MODE=real
