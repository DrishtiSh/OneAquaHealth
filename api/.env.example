PORT=4000
# Directory holding the frozen snapshot (or the .duckdb file itself); relative paths are resolved
# from the api/ folder. The file inside is oah_snapshot.duckdb.
# Build it with: python -m pipeline.snapshot.freeze_snapshot
SNAPSHOT_PATH=../data/snapshot
# How often (ms) to check for a newly frozen snapshot and hot-reload it; 0 turns this off.
SNAPSHOT_RELOAD_MS=5000
# Allowed browser origins, comma-separated; * allows any (the API is public and read-only).
CORS_ORIGIN=*
